# Meta Pixel — from Events Manager (Business Settings > Data Sources > Pixels).
# Use the EXISTING pixel per the ad-run brief — do not create a duplicate.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4 Measurement ID (G-XXXXXXXXXX) from the linked GA4 property's Data Stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site URL used for metadata + canonical tags once this is deployed.
NEXT_PUBLIC_SITE_URL=https://managed-it.truetel.com.au

# TrueTel EOD Story Engine portal (app/admin/eod-story) — talks to the
# "Truetel EOD Story Engine" workflow on the Truetel n8n instance.
EOD_N8N_BASE_URL=https://bizj1n3d.rcld.app
EOD_PORTAL_SECRET=
EOD_PORTAL_PASSWORD=

# Self-hosted HTML->PNG render endpoint (app/api/render-html) -- replaces CustomJS
RENDER_HTML_SECRET=
