# Lead notification email (Resend) — same pattern as the main truetel site.
# Without these set, the form still works but shows a "call us instead" fallback.
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=leads@truetel.com.au
RESEND_REPLY_TO=

# Meta Pixel — from Events Manager (Business Settings > Data Sources > Pixels).
# Use the EXISTING pixel per the ad-run brief — do not create a duplicate.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4 Measurement ID (G-XXXXXXXXXX) from the linked GA4 property's Data Stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site URL used for metadata + canonical tags once this is deployed.
NEXT_PUBLIC_SITE_URL=https://truetel.com.au/managed-it-services/
